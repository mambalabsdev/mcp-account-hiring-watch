{
  "name": "@mambalabsdev/mcp-account-hiring-watch",
  "version": "1.0.1",
  "description": "MCP server for Account Hiring Watch. Watch company domains and get only what changed since the last run: new, closed, and reposted job postings read live from 17 job boards, Greenhouse, Lever, Ashby, and Workday among them. Each row has the full job description, a stable posting key, and 30 day hiring velocity. Runs on Apify. Clay-ready output.",
  "type": "module",
  "bin": {
    "mcp-account-hiring-watch": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hiring-signals",
    "job-postings",
    "job-board-monitor",
    "hiring-velocity",
    "account-based-marketing",
    "apify",
    "clay",
    "lead-generation"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/account-hiring-watch",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-account-hiring-watch"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-account-hiring-watch"
}
